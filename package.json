{
  "name": "iobroker.duofernstick",
  "version": "0.1.31",
  "description": "ioBroker adapter for Rademacher DuoFern USB Stick",
  "main": "main.js",
  "scripts": {
    "check": "node --check main.js && node --check lib/protocol.js",
    "lint": "node --check main.js && node --check lib/protocol.js",
    "lint:eslint": "eslint -c eslint.config.mjs .",
    "test:js": "mocha --config test/mocharc.custom.json \"test/unit/**/*.test.js\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "translate": "translate-adapter",
    "release": "release-script"
  },
  "keywords": [
    "ioBroker",
    "iobroker-adapter",
    "duofern",
    "rademacher",
    "rollotron",
    "homepilot",
    "serialport",
    "smart-home"
  ],
  "author": "FreeProgrammer1",
  "license": "MIT",
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.1",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^3.8.0",
    "@alcalzone/release-script-plugin-iobroker": "^3.7.2",
    "@alcalzone/release-script-plugin-license": "^3.7.0",
    "@alcalzone/release-script-plugin-manual-review": "^3.7.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.2.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.15.0",
    "mocha": "^11.7.1"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FreeProgrammer1/ioBroker.duofernstick.git"
  },
  "bugs": {
    "url": "https://github.com/FreeProgrammer1/ioBroker.duofernstick/issues"
  },
  "homepage": "https://github.com/FreeProgrammer1/ioBroker.duofernstick",
  "files": [
    "admin",
    "lib",
    "main.js",
    "io-package.json",
    "README.md",
    "LICENSE"
  ]
}
